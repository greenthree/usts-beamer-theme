\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeUSTS}[2026/10/06 v1.0.1 USTS Beamer theme]

\mode<presentation>

\RequirePackage{etoolbox,graphicx}

\newcommand{\usts@footline}{full}
\DeclareOptionBeamer{footline}{\renewcommand{\usts@footline}{#1}}
\ExecuteOptionsBeamer{footline=full}
\ProcessOptionsBeamer

\usecolortheme{USTS}
\useinnertheme{rounded}
\useoutertheme{default}
\usefonttheme[onlymath]{serif}

\setbeamersize{text margin left=0.65cm,text margin right=0.65cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{items}[circle]
\setbeamertemplate{sections/subsections in toc}[circle]
\setbeamertemplate{blocks}[rounded][shadow=true]
\setbeamertemplate{caption}[numbered]

\setbeamerfont{title}{size=\Large,series=\normalfont}
\setbeamerfont{subtitle}{size=\normalsize,series=\normalfont}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{size=\large,series=\normalfont}
\setbeamerfont{framesubtitle}{size=\small,series=\normalfont}
\setbeamerfont{section title}{size=\LARGE,series=\normalfont}
\setbeamerfont{block title}{size=\normalsize,series=\normalfont}
\setbeamerfont{author in head/foot}{size=\tiny}
\setbeamerfont{title in head/foot}{size=\tiny}
\setbeamerfont{date in head/foot}{size=\tiny}

\makeatletter

\setbeamertemplate{title page}{%
  \vbox{}
  \vfill
  \begin{beamercolorbox}[wd=\textwidth,sep=0.85em,center,rounded=true,shadow=true]{title}
    {\usebeamerfont{title}\inserttitle\par}
    \ifx\insertsubtitle\@empty
    \else
      \vskip0.45em
      {\usebeamerfont{subtitle}\insertsubtitle\par}
    \fi
  \end{beamercolorbox}
  \vskip1.25em
  \begin{center}
    {\usebeamerfont{author}\insertauthor\par}
    \ifx\insertinstitute\@empty
    \else
      \vskip0.65em
      {\usebeamerfont{institute}\insertinstitute\par}
    \fi
    \ifx\insertdate\@empty
    \else
      \vskip0.85em
      {\usebeamerfont{date}\insertdate\par}
    \fi
    \ifx\inserttitlegraphic\@empty
    \else
      \vskip1.0em
      \inserttitlegraphic\par
    \fi
  \end{center}
  \vfill
}

\setbeamertemplate{section page}{%
  \begin{centering}
    \vfill
    \begin{beamercolorbox}[wd=0.88\textwidth,sep=1.1em,center,rounded=true,shadow=true]{section title}
      \usebeamerfont{section title}\insertsection\par
    \end{beamercolorbox}
    \vfill
  \end{centering}
}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,vmode,leftskip=\beamer@leftmargin,rightskip=\beamer@rightmargin]{frametitle}
    \vskip0.6ex
    {\usebeamerfont{frametitle}\strut\insertframetitle\strut\par}%
    \ifx\insertframesubtitle\@empty
    \else
      {\usebeamerfont{framesubtitle}\strut\insertframesubtitle\strut\par}%
    \fi
    \vskip0.6ex
  \end{beamercolorbox}%
}

% Keep footer text on one line and shrink only when it exceeds its column.
\newsavebox{\usts@footlinebox}
\newcommand{\usts@fitfootline}[2]{%
  \sbox{\usts@footlinebox}{#2}%
  \ifdim\wd\usts@footlinebox>#1\relax
    \resizebox{#1}{!}{\usebox{\usts@footlinebox}}%
  \else
    \usebox{\usts@footlinebox}%
  \fi
}

\defbeamertemplate*{footline}{usts-full}{%
  \leavevmode
  \hbox{%
    \begin{beamercolorbox}[wd=.32\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
      \usebeamerfont{author in head/foot}%
      \usts@fitfootline{\dimexpr.32\paperwidth-0.4cm\relax}{%
        \insertshortauthor%
        \ifx\beamer@shortinstitute\@empty\else\hspace{0.35em}(\insertshortinstitute)\fi
      }%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.36\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
      \usebeamerfont{title in head/foot}%
      \usts@fitfootline{\dimexpr.36\paperwidth-0.4cm\relax}{\insertshorttitle}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.32\paperwidth,ht=2.25ex,dp=1ex,right,rightskip=\beamer@rightmargin]{date in head/foot}%
      \usebeamerfont{date in head/foot}%
      \usts@fitfootline{\dimexpr.32\paperwidth-\beamer@rightmargin-0.2cm\relax}{%
        \insertshortdate\hspace{1em}\insertframenumber{} / \inserttotalframenumber
      }%
    \end{beamercolorbox}%
  }%
}

\defbeamertemplate*{footline}{usts-minimal}{%
  \leavevmode
  \hbox{%
    \begin{beamercolorbox}[wd=.84\paperwidth,ht=2.25ex,dp=1ex,left,leftskip=\beamer@leftmargin]{title in head/foot}%
      \usebeamerfont{title in head/foot}%
      \usts@fitfootline{\dimexpr.84\paperwidth-\beamer@leftmargin-0.2cm\relax}{\insertshorttitle}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.16\paperwidth,ht=2.25ex,dp=1ex,right,rightskip=\beamer@rightmargin]{date in head/foot}%
      \usebeamerfont{date in head/foot}%
      \usts@fitfootline{\dimexpr.16\paperwidth-\beamer@rightmargin-0.1cm\relax}{%
        \insertframenumber{} / \inserttotalframenumber
      }%
    \end{beamercolorbox}%
  }%
}

\defbeamertemplate*{footline}{usts-none}{}

\ifdefstring{\usts@footline}{none}{%
  \setbeamertemplate{footline}[usts-none]
}{%
  \ifdefstring{\usts@footline}{minimal}{%
    \setbeamertemplate{footline}[usts-minimal]
  }{%
    \ifdefstring{\usts@footline}{full}{%
      \setbeamertemplate{footline}[usts-full]
    }{%
      \PackageWarning{beamerthemeUSTS}{Unknown footline option `\usts@footline'; using `full'}%
      \setbeamertemplate{footline}[usts-full]
    }%
  }%
}

\makeatother

\mode<all>
