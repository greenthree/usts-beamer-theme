\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeUSTS}[2026/10/06 v1.0.0 USTS Beamer color theme]

\mode<presentation>
\RequirePackage{xcolor}

% School blue; Madrid derives the block and footer colors from this color.
\definecolor{USTSBlue}{RGB}{0,140,215}
