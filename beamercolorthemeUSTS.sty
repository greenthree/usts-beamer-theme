\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeUSTS}[2026/10/06 v2.0.0 Reference USTS color theme]

\mode<presentation>
\RequirePackage{xcolor}

% Preserve the reference color and let Madrid derive all other colors.
\definecolor{mycolor}{RGB}{0,140,215}
\colorlet{USTSBlue}{mycolor}
\usecolortheme[named=mycolor]{structure}
\setbeamercolor{normal text}{fg=black}
\setbeamercolor{alerted text}{fg=mycolor}

\mode<all>
